#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        sk_shift: sk_shift {
            compatible = "zmk,behavior-sticky-key";
            label = "SK_SHIFT";
            bindings = <&sk>;
            #binding-cells = <1>;
            quick-release;
            release-after-ms = <500>;
        };
    };

    combos {
        compatible = "zmk,combos";

        coloncombo {
            bindings = <&kp COLON>;
            key-positions = <43 44>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE      &kp N1  &kp N2  &kp N3     &kp N4      &kp N5  &trans                                                                       &trans  &kp N6  &kp N7         &kp N8     &kp N9   &kp N0      &kp DELETE
&kp TAB        &kp Q   &kp W   &kp E      &kp R       &kp T   &none                                                                        &none   &kp Y   &kp U          &kp I      &kp O    &kp P       &kp BSPC
&mt LCTRL ESC  &kp A   &kp S   &kp D      &kp F       &kp G   &none     &kp TAB      &trans                &kp DEL        &kp RCTRL        &none   &kp H   &kp J          &kp K      &kp L    &lt 3 SEMI  &kp APOSTROPHE
&kp LSHFT      &kp Z   &kp X   &kp C      &kp V       &kp B                          &mo 1                 &kp BACKSPACE                           &kp N   &kp M          &kp COMMA  &kp DOT  &kp FSLH    &kp RSHFT
&mo 5          &trans  &trans  &kp SPACE  &kp ESCAPE          &kp LALT  &lt 1 SPACE  &kp LEFT_COMMAND      &kp ENTER      &sk_shift LSHFT  &mo 2           &kp BACKSPACE  &trans     &trans   &trans      &mo 2
            >;
        };

        number {
            display-name = "Number";
            bindings = <
&trans  &trans    &trans       &trans    &trans      &trans       &none                                       &none   &trans        &trans         &trans        &trans                &trans                 &trans
&trans  &kp EXCL  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &none                                       &none   &kp CARET     &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp N1    &kp N2       &kp N3    &kp N4      &kp N5       &trans  &trans  &trans      &trans  &trans  &trans  &kp NUMBER_6  &kp N7         &kp N8        &kp N9                &kp N0                 &trans
&trans  &trans    &trans       &trans    &trans      &trans                       &trans      &trans                  &trans        &trans         &trans        &trans                &trans                 &trans
&trans  &trans    &trans       &trans    &trans                   &trans  &trans  &trans      &trans  &trans  &trans                &trans
            >;
        };

        symbol {
            display-name = "Symbol";
            bindings = <
&kp EQUAL  &trans         &trans           &trans     &trans  &trans    &none                                       &none   &trans     &trans          &trans                &trans    &trans            &trans
&trans     &trans         &trans           &kp HASH   &trans  &trans    &none                                       &none   &kp PIPE   &kp EXCL        &kp LEFT_PARENTHESIS  &kp RPAR  &kp PLUS          &trans
&trans     &kp AMPERSAND  &kp STAR         &kp DLLR   &kp N4  &kp N5    &trans  &trans  &trans      &trans  &trans  &trans  &kp MINUS  &kp EQUAL       &kp LBKT              &kp RBKT  &kp GREATER_THAN  &kp LESS_THAN
&trans     &kp PERCENT    &kp EXCLAMATION  &kp CARET  &trans  &kp EXCL                  &trans      &trans                  &trans     &kp UNDERSCORE  &kp LBRC              &kp RBRC  &kp BACKSLASH     &trans
&trans     &trans         &trans           &trans     &trans            &trans  &trans  &trans      &trans  &trans  &trans             &kp UNDER
            >;
        };

        nav {
            display-name = "Nav";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &none                                       &mo 3   &kp F7    &kp F8    &kp F9  &kp F10    &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans    &trans    &trans  &trans     &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans    &trans    &trans  &trans     &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans            &trans    &trans  &trans     &trans   &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
